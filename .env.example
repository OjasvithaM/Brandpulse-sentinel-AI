# =============================================================================
# BrandPulse Sentinel AI — Environment Configuration
# =============================================================================

# NODE_ENV: Set to 'production' in live deployments.
# Enforces strict cookie security, disables demo-role switching, and requires secrets.
NODE_ENV="development"

# DATABASE_PATH: Optional absolute or relative file path to the SQLite governance database.
# Defaults to './data/brandpulse.db'. Use a persistent volume mount in production container runtimes.
DATABASE_PATH="./data/brandpulse.db"

# PASSPORT_SIGNING_SECRET: Master cryptographic seed for Ed25519 Trust Passport signatures.
# In production (NODE_ENV=production), this variable MUST be set to a secure, non-default value.
PASSPORT_SIGNING_SECRET="brandpulse-sentinel-master-secret-key-2026-acme-governance"

# SESSION_SECRET: Secret key for signing and validating session tokens.
SESSION_SECRET="brandpulse-session-secret-salt-2026-production"

# SCHEDULER_SECRET: Bearer authentication secret token for Cloud Scheduler sync endpoint.
# Invoked via: POST /api/scheduler/sync with Authorization: Bearer <SCHEDULER_SECRET>
SCHEDULER_SECRET="bp-scheduler-secret-token-2026"

# APP_URL: The public or local URL where this applet is hosted (e.g., http://localhost:3000).
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Optional API key for semantic AI claim extraction and verification.
# If omitted, BrandPulse Sentinel AI operates autonomously using its deterministic matching engine.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ACME_LIVE_API_KEY: Optional secret bearer token or API key for authenticating to authorized live external feeds.
ACME_LIVE_API_KEY="OPTIONAL_AUTHORIZED_FEED_SECRET"


